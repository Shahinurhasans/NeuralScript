---
import { SITE } from '../config';
import { url } from '../utils/url';

interface Props {
  /** Also link the RSS feed. */
  rss?: boolean;
}

const { rss = false } = Astro.props;
const { cv, links } = SITE;
const items = [
  { label: 'CV', href: cv && (cv.startsWith('/') ? url(cv) : cv) },
  { label: 'Email', href: links.email && `mailto:${links.email}` },
  { label: 'GitHub', href: links.github },
  { label: 'Google Scholar', href: links.scholar },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'ORCID', href: links.orcid },
  { label: 'Portfolio', href: links.portfolio },
  { label: 'RSS', href: rss ? url('/rss.xml') : '' },
].filter((item) => item.href);
---

{
  items.length > 0 && (
    <ul class="profile-links">
      {items.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  )
}
