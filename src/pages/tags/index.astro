---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags, tagUrl } from '../../utils/posts';

const tags = getTags(await getPosts());
---

<BaseLayout title="Tags" description="Posts grouped by topic.">
  <header class="page-header">
    <h1>Tags</h1>
    <p class="lede">Posts grouped by topic.</p>
  </header>

  {tags.length === 0 && <p class="empty">No tags yet.</p>}

  <ul class="tag-cloud">
    {
      tags.map((tag) => (
        <li>
          <a href={tagUrl(tag.name)}>
            #{tag.name}
            <span class="count">{tag.posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
