---
// Every post title by year, newest first: a compact list for scanning everything at once.
import { SITE } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, type Post, postUrl } from '../../utils/posts';

const posts = await getPosts();
const years = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}

const day = (date: Date) => date.toLocaleDateString(SITE.locale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Archives" description={`Every post on ${SITE.title}, by year.`}>
  <header class="page-header">
    <h1>Archives</h1>
  </header>

  {posts.length === 0 && <p class="feed-empty">The first post is on its way.</p>}

  {
    [...years].map(([year, list]) => (
      <section aria-labelledby={`year-${year}`}>
        <h2 class="archive-year" id={`year-${year}`}>
          {year}
        </h2>
        <ol class="archive-list">
          {list.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{day(post.data.date)}</time>
              <a href={postUrl(post)}>{post.data.title}</a>
              {post.data.draft && <span class="badge">Draft</span>}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>
